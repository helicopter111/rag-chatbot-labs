# Copy this file to .env and fill in values.
# .env is ignored by git so keys never get uploaded.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://rag:rag@127.0.0.1:5432/rag

# Ollama is a local model server: http://localhost:11434
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Which chat provider to use: ollama | openai | anthropic
# Embeddings stay on Ollama so the Postgres vector column size does not change.
LLM_PROVIDER=ollama

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-latest

# RAG knobs
TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
